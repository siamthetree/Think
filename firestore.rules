rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // PILLAR 1: GLOBAL DENY BY DEFAULT
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // SHARED HELPER FUNCTIONS
    // ---------------------------------------------------------
    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isBoundedStringList(listVal, maxItems, maxItemLen) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= maxItemLen));
    }

    // Master Gate: confirms /users/{userId} root doc exists and belongs to caller (NEVER used inside allow list)
    function isMasterOwner(userId) {
      return isOwner(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // ENTITY VALIDATORS (LENGTH BOUNDED & FIELD WHITELISTED)
    // ---------------------------------------------------------
    function isValidUserRoot(data) {
      return data.keys().hasAll(['ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && isOptionalString(data, 'displayName', 120)
        && isOptionalString(data, 'photoUrl', 512)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPreferencesMap(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['font', 'fontSize', 'theme', 'lineHeight', 'distractionFree'])
        && prefs.keys().hasOnly(['font', 'fontSize', 'theme', 'lineHeight', 'distractionFree'])
        && prefs.font in ['serif', 'sans', 'mono']
        && prefs.fontSize is number && prefs.fontSize >= 12 && prefs.fontSize <= 36
        && prefs.theme in ['paper', 'sepia', 'clean', 'slate', 'oled']
        && prefs.lineHeight in ['normal', 'relaxed', 'loose']
        && prefs.distractionFree is bool;
    }

    function isValidHabitMap(habit) {
      return habit is map
        && habit.keys().hasAll(['dailyGoal', 'todayDate', 'todayReadIds', 'todayMinutes', 'streakDays'])
        && habit.keys().hasOnly(['dailyGoal', 'todayDate', 'todayReadIds', 'todayMinutes', 'streakDays', 'lastCompletedDate', 'totalReadIds'])
        && habit.dailyGoal is number && habit.dailyGoal >= 1 && habit.dailyGoal <= 100
        && habit.todayDate is string && habit.todayDate.size() <= 20
        && isBoundedStringList(habit.todayReadIds, 200, 128)
        && habit.todayMinutes is number && habit.todayMinutes >= 0 && habit.todayMinutes <= 10000
        && habit.streakDays is number && habit.streakDays >= 0 && habit.streakDays <= 50000
        && (!('lastCompletedDate' in habit) || habit.lastCompletedDate == null || (habit.lastCompletedDate is string && habit.lastCompletedDate.size() <= 20))
        && (!('totalReadIds' in habit) || isBoundedStringList(habit.totalReadIds, 500, 128));
    }

    function isValidSpeedObservation(obs) {
      return obs is map
        && obs.keys().hasAll(['articleId', 'language', 'wordCount', 'lineCount', 'activeMs', 'wpm', 'timestamp'])
        && obs.keys().hasOnly(['articleId', 'language', 'wordCount', 'lineCount', 'activeMs', 'wpm', 'timestamp'])
        && obs.articleId is string && obs.articleId.size() >= 1 && obs.articleId.size() <= 128
        && obs.language in ['en', 'bn']
        && obs.wordCount is number && obs.wordCount >= 0 && obs.wordCount <= 500000
        && obs.lineCount is number && obs.lineCount >= 0 && obs.lineCount <= 100000
        && obs.activeMs is number && obs.activeMs >= 0 && obs.activeMs <= 100000000
        && obs.wpm is number && obs.wpm >= 1 && obs.wpm <= 10000
        && obs.timestamp is number && obs.timestamp >= 0;
    }

    function isValidLangSpeedStats(stats) {
      return stats is map
        && stats.keys().hasAll(['observedCount', 'observations'])
        && stats.keys().hasOnly(['observedCount', 'learnedWpm', 'learnedMsPerWord', 'learnedMsPerLine', 'observations'])
        && stats.observedCount is number && stats.observedCount >= 0 && stats.observedCount <= 100000
        && (!('learnedWpm' in stats) || stats.learnedWpm == null || (stats.learnedWpm is number && stats.learnedWpm >= 1 && stats.learnedWpm <= 10000))
        && (!('learnedMsPerWord' in stats) || stats.learnedMsPerWord == null || (stats.learnedMsPerWord is number && stats.learnedMsPerWord >= 0 && stats.learnedMsPerWord <= 100000))
        && (!('learnedMsPerLine' in stats) || stats.learnedMsPerLine == null || (stats.learnedMsPerLine is number && stats.learnedMsPerLine >= 0 && stats.learnedMsPerLine <= 100000))
        && stats.observations is list && stats.observations.size() <= 50
        && (stats.observations.size() == 0 || isValidSpeedObservation(stats.observations[0]));
    }

    function isValidSpeedProfileMap(profile) {
      return profile is map
        && profile.keys().hasAll(['en', 'bn'])
        && profile.keys().hasOnly(['en', 'bn'])
        && isValidLangSpeedStats(profile.en)
        && isValidLangSpeedStats(profile.bn);
    }

    function isValidCloudState(data) {
      return data.keys().hasAll(['ownerId', 'folders', 'preferences', 'readingHabit', 'readingSpeedProfile', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'folders', 'preferences', 'readingHabit', 'readingSpeedProfile', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && isBoundedStringList(data.folders, 50, 64)
        && isValidPreferencesMap(data.preferences)
        && isValidHabitMap(data.readingHabit)
        && isValidSpeedProfileMap(data.readingSpeedProfile)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscribedSource(data) {
      return data.keys().hasAll(['ownerId', 'id', 'title', 'url', 'category', 'defaultTags', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'title', 'url', 'siteUrl', 'category', 'description', 'defaultTags', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 1024
        && isOptionalString(data, 'siteUrl', 1024)
        && data.category is string && data.category.size() <= 80
        && isOptionalString(data, 'description', 500)
        && isBoundedStringList(data.defaultTags, 20, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedBookmark(data) {
      return data.keys().hasAll(['ownerId', 'id', 'feedId', 'feedTitle', 'title', 'link', 'timestamp', 'tags', 'readTimeMin', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'feedId', 'feedTitle', 'feedUrl', 'title', 'link', 'pubDate', 'timestamp', 'author', 'summary', 'imageUrl', 'tags', 'readTimeMin', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.feedId is string && data.feedId.size() >= 1 && data.feedId.size() <= 128
        && data.feedTitle is string && data.feedTitle.size() >= 1 && data.feedTitle.size() <= 200
        && isOptionalString(data, 'feedUrl', 1024)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 400
        && data.link is string && data.link.size() >= 1 && data.link.size() <= 1024
        && isOptionalString(data, 'pubDate', 64)
        && data.timestamp is number && data.timestamp >= 0
        && isOptionalString(data, 'author', 160)
        && isOptionalString(data, 'summary', 600)
        && isOptionalString(data, 'imageUrl', 1024)
        && isBoundedStringList(data.tags, 20, 64)
        && data.readTimeMin is number && data.readTimeMin >= 1 && data.readTimeMin <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadEntry(data) {
      return data.keys().hasAll(['ownerId', 'entryKey', 'readAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'entryKey', 'canonicalUrl', 'headlineKey', 'readAt', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.entryKey is string && data.entryKey.size() >= 1 && data.entryKey.size() <= 256
        && isOptionalString(data, 'canonicalUrl', 1024)
        && isOptionalString(data, 'headlineKey', 300)
        && data.readAt is number && data.readAt >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // USER ROOT DOCUMENT
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserRoot(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserRoot(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if false;

      // ---------------------------------------------------------
      // SYNCED READER META STATE (/users/{userId}/meta/{stateId})
      // ---------------------------------------------------------
      match /meta/{stateId} {
        allow get: if isValidId(stateId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isValidId(stateId)
          && isMasterOwner(userId)
          && isValidCloudState(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(stateId)
          && isMasterOwner(userId)
          && isValidCloudState(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['folders', 'preferences', 'readingHabit', 'readingSpeedProfile', 'updatedAt']);

        allow delete: if isValidId(stateId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
      }

      // ---------------------------------------------------------
      // SUBSCRIBED SOURCES (/users/{userId}/sources/{sourceId})
      // ---------------------------------------------------------
      match /sources/{sourceId} {
        allow get: if isValidId(sourceId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isValidId(sourceId)
          && isMasterOwner(userId)
          && isValidSubscribedSource(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(sourceId)
          && isMasterOwner(userId)
          && isValidSubscribedSource(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'siteUrl', 'category', 'description', 'defaultTags', 'updatedAt']);

        allow delete: if isValidId(sourceId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
      }

      // ---------------------------------------------------------
      // BOOKMARKS (/users/{userId}/bookmarks/{bookmarkId})
      // ---------------------------------------------------------
      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(bookmarkId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isValidId(bookmarkId)
          && isMasterOwner(userId)
          && isValidSavedBookmark(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(bookmarkId)
          && isMasterOwner(userId)
          && isValidSavedBookmark(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'author', 'summary', 'imageUrl', 'tags', 'readTimeMin', 'updatedAt']);

        allow delete: if isValidId(bookmarkId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
      }

      // ---------------------------------------------------------
      // READ ARTICLE ENTRIES (/users/{userId}/readEntries/{entryId})
      // ---------------------------------------------------------
      match /readEntries/{entryId} {
        allow get: if isValidId(entryId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isValidId(entryId)
          && isMasterOwner(userId)
          && isValidReadEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(entryId)
          && isMasterOwner(userId)
          && isValidReadEntry(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().entryKey == existing().entryKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['canonicalUrl', 'headlineKey', 'readAt', 'updatedAt']);

        allow delete: if isValidId(entryId) && isMasterOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
